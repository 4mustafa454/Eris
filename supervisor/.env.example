# Copy to .env.local and fill in privately. Never commit .env.local.

# LiveKit: all three values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
# Agent Console needs your own LiveKit project, so fill all three for development.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# The name this agent registers with. chert dev and chert doctor read it from .env.local.
AGENT_NAME=eris

# Speech. STT_PROVIDER: deepgram | elevenlabs. TTS_PROVIDER: elevenlabs | deepgram.
# Defaults use two different providers so one outage or empty credit pool does not kill both directions.
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID

# The PM's language model. Empty LLM_BASE_URL means OpenAI.
# For a local Ollama use LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=gpt-oss:20b (no OpenAI key needed).
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini

# The harness (API, database, workers). Start it first: cd harness && .venv/bin/uvicorn app.main:app --port 8787
HARNESS_URL=http://localhost:8787

# Agent Console development only: 1 also greets when the caller joins, because Agent Console never sends
# Chert's bridge_ready signal. Leave at 0 (or unset) with chert dev; it is ignored for chert-bridge-* callers.
GREET_ON_JOIN=0
