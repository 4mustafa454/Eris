# Copy to .env.local and fill in privately. Never commit .env.local.
# Names only: comments say what each variable does and its default. Empty means unset.

# --- LiveKit ---------------------------------------------------------------------------------------
# All three belong to one LiveKit project. On a Shared plan with Chert rooms leave all three empty:
# calls then run in Chert's LiveKit. Agent Console needs your own project, so fill them for development.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent -----------------------------------------------------------------------------------------
# Name registered with LiveKit; chert dev and chert doctor read it from here. Use: eris
AGENT_NAME=

# --- Provider keys shared by speech roles ----------------------------------------------------------
# Used when STT_PROVIDER / TTS_PROVIDER is deepgram or elevenlabs.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- STT (speech to text) --------------------------------------------------------------------------
# STT_PROVIDER: deepgram | elevenlabs | openai-compatible. Default: deepgram
STT_PROVIDER=
# openai-compatible only: any server with an OpenAI-style /audio/transcriptions endpoint.
# STT_BASE_URL and STT_MODEL are required; STT_API_KEY is optional.
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=

# --- TTS (text to speech) --------------------------------------------------------------------------
# TTS_PROVIDER: deepgram | elevenlabs | openai-compatible. Default: deepgram
TTS_PROVIDER=
# elevenlabs only: the voice to use (the plugin's default voice if empty).
ELEVENLABS_VOICE_ID=
# openai-compatible only: any server with an OpenAI-style /audio/speech endpoint.
# TTS_BASE_URL, TTS_MODEL and TTS_VOICE are required; TTS_API_KEY is optional.
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_API_KEY=

# --- LLM (the PM's brain) --------------------------------------------------------------------------
# LLM_PROVIDER: openai | openai-compatible. Default: openai
LLM_PROVIDER=
# openai: needs OPENAI_API_KEY unless LLM_BASE_URL is set. Ollama: LLM_BASE_URL=http://localhost:11434/v1
# with LLM_MODEL=gpt-oss:20b and no key. LLM_MODEL defaults to gpt-5-mini.
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# openai-compatible: LLM_BASE_URL and LLM_MODEL are required; LLM_API_KEY is optional.
LLM_API_KEY=

# --- Harness ---------------------------------------------------------------------------------------
# Start it first: cd harness && .venv/bin/uvicorn app.main:app --port 8787. Default: http://localhost:8787
HARNESS_URL=

# --- Development -----------------------------------------------------------------------------------
# GREET_ON_JOIN=1 also greets when the caller joins, because Agent Console never sends Chert's
# bridge_ready signal. Off unless exactly 1. Ignored for chert-bridge-* callers, so it cannot fire on a
# real FaceTime call. Do not set it when running with chert dev.
GREET_ON_JOIN=
# Log level for the supervisor. Default: info
LOG_LEVEL=
