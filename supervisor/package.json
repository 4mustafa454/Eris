{
  "name": "chert-student-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env.local agent.mjs start",
    "check": "find . -path ./node_modules -prune -o -name '*.mjs' -print | xargs -n1 node --check",
    "test": "node --test",
    "help": "node agent.mjs --help",
    "render:samples": "node render/dump-samples.mjs",
    "frames": "node --env-file-if-exists=.env.local render/serve.mjs"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-deepgram": "1.8.0",
    "@livekit/agents-plugin-elevenlabs": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/agents-plugin-silero": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "@napi-rs/canvas": "1.1.0"
  }
}
