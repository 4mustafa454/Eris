# Copy to harness/.env (gitignored) and fill in. Names only here: never put a value in this file.

# --- Real workers ---------------------------------------------------------------------------------
# Comma-separated agent ids that run as real workers in Docker, e.g. agent-1,agent-3. Empty = all mock.
REAL_WORKERS=
# From `claude setup-token` run once on the host (or use ANTHROPIC_API_KEY). Required for real Claude workers.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Docker image for the worker. Default: eris-claude-code:2.1.316
WORKER_IMAGE=
# Codex worker image (finalized when built).
CODEX_WORKER_IMAGE=
# Explicit Codex model and reasoning effort; defaults are gpt-6.1-terra and medium.
CODEX_MODEL=
CODEX_REASONING=
# ntfy.sh topic for worker alerts.
NTFY_TOPIC=
# Comma-separated: ntfy, imessage, facetime_call. imessage and facetime_call use the Chert settings below.
ALERT_CHANNELS=
# text, call, or text_then_call. Default: text.
ALERT_MODE=
# Recipient of iMessage / FaceTime alerts: your phone number in E.164 (or Apple ID email). Must be verified with Chert.
ALERT_TO=
# 1 = log what each alert channel would send instead of sending (ntfy, iMessage, call). Default: off.
ALERT_DRY_RUN=
# iMessage alerts: the Messaging API signing secret from the Chert console.
CHERT_SIGNING_SECRET=
# FaceTime call alerts: a project API key with facetime:write + facetime:read, the project UUID, the outbound line UUID.
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
# Same three LiveKit values as supervisor/.env.local (the harness creates the alert call's room) and the supervisor's AGENT_NAME.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=
# Where the supervisor serves the current picture (attached to iMessage alerts). Default: http://localhost:8788/frame.jpg
FRAME_URL=

# --- PM web chat (/chat) and settings ----------------------------------------------------------------
# The dashboard's Settings page reads and writes these. LLM_PROVIDER: openai | openai-compatible. Default: openai
LLM_PROVIDER=
# Empty = OpenAI. An Ollama or other OpenAI-style server: http://localhost:11434/v1
LLM_BASE_URL=
# Default: gpt-5-mini
LLM_MODEL=
# Key for the PM web chat when LLM_BASE_URL is not OpenAI (never sent to OpenAI).
LLM_API_KEY=
# Key for the PM web chat against OpenAI.
OPENAI_API_KEY=
# STT_PROVIDER / TTS_PROVIDER: deepgram | elevenlabs | openai-compatible. Default: deepgram. Shown in Settings; the supervisor reads its own copy.
STT_PROVIDER=
TTS_PROVIDER=
# Keys the Settings page can store and test; the supervisor reads its own from supervisor/.env.local.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Development and tests ---------------------------------------------------------------------------
# SQLite file. Default: harness/data/eris.db
ERIS_DB_PATH=
# Browser origins allowed to call the API, comma-separated; replaces the default list (localhost :5173 and :5190). Never *
ERIS_CORS_ORIGINS=
# Set in the shell, not here: read this env file instead of harness/.env.
ERIS_ENV_FILE=
# 1 = mock agents change state on a timer (demo without workers). Default: off
MOCK_TICK=
# Seconds between mock ticks, at least 0.5. Default: 4
MOCK_TICK_SECONDS=
# --max-turns for each claude run, 1 to 200. Default: 30
CLAUDE_MAX_TURNS=
# The git repo the worker edits, mounted at /workspace. Default: ../demo-repo (relative to harness/)
DEMO_REPO=
# Optional: append the raw claude stream-json (secrets redacted) to this file, to debug a run. Relative to harness/.
ERIS_STREAM_LOG=
